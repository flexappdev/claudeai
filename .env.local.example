# Copy to .env.local and fill in values.
# `/abc-mongo sync claudeai` writes MONGODB_URI; the rest are manual.

# Core
MONGODB_URI=
MONGODB_DB=claudeai

# Provider — when OPENROUTER_API_KEY is set, all LLM calls route through
# OpenRouter (anthropic/* models). Otherwise ANTHROPIC_API_KEY is used directly.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:17001

# CC-07 — Connectors (optional in dev; absent shows "Not configured" pill)
CONNECTOR_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# CC-08 — Analytics
NEXT_PUBLIC_GA_ID=
